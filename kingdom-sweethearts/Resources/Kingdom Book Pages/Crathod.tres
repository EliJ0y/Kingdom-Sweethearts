script = ExtResource("1_02aga")
page_title = "Crathod"
page_content = Array[String](["Crathod is home to tradespeople, tinkerers, and engineers. The people dedicate vast amounts of time and effort to their crafts.", "Those in Crathod are innovative and meticulous, crafting the many mundane things and wonders of our lives today.", "Crathod’s crafts landscape is ever growing and shifting."])
