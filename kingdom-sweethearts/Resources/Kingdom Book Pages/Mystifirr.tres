page_title = "Mystifirr"
page_content = Array[String](["Mystifirr is home to magic wielders, problem-solvers, and visionaries. The people have power within they keep grounded.", "Those in Mystifirr are sharp and  optimistic, always ready to tackle challenges and hope for a better future for everyone.", "Mystifirr’s magic vary from small conveniences to incredible feats."])
