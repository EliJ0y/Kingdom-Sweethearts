page_title = "Philsopoll"
page_content = Array[String](["Philsopoll is home to scientists, knowledge-seekers, and scholars. The people hunger for answers to anything and everything.", "Those in Philsopoll are curious and intelligent, uncovering as well as recording the details of the world and our lives.", "Philsopoll’s libraries can be overwhelming to average people."])
