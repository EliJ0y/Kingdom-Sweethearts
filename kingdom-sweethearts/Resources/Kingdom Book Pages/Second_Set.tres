[resource]
script = ExtResource("1_0euuu")
left_page_title = "Mystifirr"
left_page_content = Array[String](["Mystifirr is home to magic wielders, problem-solvers, and visionaries. The people have power within they keep grounded.", "Those in Mystifirr are sharp and  optimistic, always ready to tackle challenges and hope for a better future for everyone.", "Mystifirr’s magic vary from small conveniences to  incredible feats."])
right_page_title = "Vigoust"
right_page_content = Array[String](["Vigoust is home to warriors, peace-keepers, and adventurers. The people hone themselves in pursuit of greatness.", "Those in Vigoust are courageous and determined, giving their body and soul to fight, protect, or conquer.", "Vigoust’s legends tell tales of both heroes and tyrants."])
metadata/_custom_type_script = "uid://bfol2ssr330a1"
