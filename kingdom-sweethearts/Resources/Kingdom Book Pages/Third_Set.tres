[resource]
script = ExtResource("1_0euuu")
left_page_title = "Crathod"
left_page_content = Array[String](["Crathod is home to tradespeople, tinkerers, and engineers. The people dedicate vast amounts of time and effort to their crafts.", "Those in Crathod are innovative and meticulous, crafting the many mundane things and wonders of our lives today.", "Crathod’s crafts landscape is ever growing and shifting."])
right_page_title = "Philsopoll"
right_page_content = Array[String](["Philsopoll is home to scientists, knowledge-seekers, and scholars. The people hunger for answers to anything and everything.", "Those in Philsopoll are curious and intelligent, uncovering as well as recording the details of the world and our lives.", "Philsopoll’s libraries can be overwhelming to average people."])
metadata/_custom_type_script = "uid://bfol2ssr330a1"
