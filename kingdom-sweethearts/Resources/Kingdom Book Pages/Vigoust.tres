page_title = "Vigoust"
page_content = Array[String](["Vigoust is home to warriors, peace-keepers, and adventurers. The people hone themselves in pursuit of greatness.", "Those in Vigoust are courageous and determined, giving their body and soul to fight, protect, or conquer.", "Vigoust’s legends tell tales of both heroes and tyrants."])
