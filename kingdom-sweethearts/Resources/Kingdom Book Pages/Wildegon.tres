script = ExtResource("1_5v7h4")
page_title = "Wildegon"
page_content = Array[String](["Wildegon is home to hunters, survivalists, and fighters. The people live as one with the surrounding nature.", "Those in Wildegon are adaptable and resourceful, subsisting off the land while appreciating its beauty.", "Wildegon’s forests regularly bloom with flowers, namely trilliums and violets."])
