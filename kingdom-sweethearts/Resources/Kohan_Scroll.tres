script = ExtResource("1_3k75i")
texturebutton = ExtResource("2_srq50")
lines = Array[String](["I am Duke Kohan from Wildegon.", "I am aware that you, Cupid, will assist in my matchmaking with the charming Duke Silvester from Oceirea in three days.", "One of the few things I know of him is his great sense of responsibility to Oceirea. It seems unlikely for him to travel.", "As such, I believe it would be beneficial to bring postcards as a gift.", "May we get along well."])
