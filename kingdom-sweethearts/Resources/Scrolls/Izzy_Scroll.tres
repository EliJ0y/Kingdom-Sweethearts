script = ExtResource("2_nty7a")
texturebutton = ExtResource("3_allu8")
lines = Array[String](["Salutations from Izzy Phillos, the heir to Philsopoll.", "Nasim Cranter is a wonderfully fitting match! I will take full advantage of this chance to learn of their precise craft. Intriguingly, her sense of self is non-rigid too, in contrast. I must share with them of such occurrences in nature!", "Ah, I am getting ahead of myself. Flower printing is rising in popularity, and will thus make an appropriate gift.", "Knowledge, and possibly, love awaits!"])
