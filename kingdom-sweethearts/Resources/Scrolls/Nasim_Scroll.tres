texturebutton = ExtResource("3_6yqcf")
lines = Array[String](["Pleased to meet you, Cupid. I am Nasim Cranter, the heir to Crathod.", "I simply cannot wait to meet the heir of Philsopoll, Izzy, in two days! While our fields differ, I am sure we can learn much from each other!", "While we are both passionate, I recall tales of them forgetting his bodily needs. I hazard a guess that the pastries for our meeting might need to be slightly more intricate for it to remember to take a bite.", "Well wishes to you and Izzy!"])
