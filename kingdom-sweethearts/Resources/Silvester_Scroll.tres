texturebutton = ExtResource("2_4i4uf")
lines = Array[String](["Hail and well met from Oceirea!", "I am Duke Silvester, who is set to be matchmade with Duke Kohan from Wildegon in three days.", "I have heard much of his strength and admire him greatly! I do hope these feelings are mutual.", "To help you in your preparations, I have heard that Duke Kohan has a soft spot for flowers. Perhaps a bouquet would be a nice gift?", "I eagerly anticipate meeting him!"])
